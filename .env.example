# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
# Dev/mock mode: enables /api/dev/* endpoints. API REFUSES to start if true with NODE_ENV=production.
DEV_MODE=true
# DEV_MODE is refused when WEBAPP_URL / PUBLIC_BASE_URL are not local addresses (the dev endpoints mint valid
# logins). Only set this if you really know what you are doing.
ALLOW_REMOTE_DEV_MODE=false
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173
# Serve the built web app (apps/web/dist) from the API process = single-origin mode.
# Default: true in production, false otherwise. Needs `pnpm build` first.
SERVE_WEB=
WEB_DIST_DIR=
# Set true behind a reverse proxy / tunnel so rate limits see the real client IP (X-Forwarded-For)
TRUST_PROXY=false
# How long Telegram initData stays valid after its auth_date, in seconds (Telegram never refreshes it
# during a session, so 1h would log users out mid-use). Default 24h.
INITDATA_MAX_AGE_SEC=86400

# ---------- Database ----------
# SQLite in dev; for prod switch provider in prisma/schema.prisma to "postgresql" and use a postgres URL (see README)
DATABASE_URL=file:./dev.db

# ---------- Telegram ----------
# Token from @BotFather. In DEV_MODE a dummy token is fine (initData is signed with it locally).
BOT_TOKEN=000000:dev-token-change-me
BOT_USERNAME=storychain_bot
# Optional Mini App short name (https://t.me/<bot>/<short>?startapp=...)
APP_SHORT_NAME=
# Start the bot? Default: true in production, false otherwise. Set true (with a real BOT_TOKEN) to test /start
BOT_ENABLED=false
# polling (dev) | webhook (prod)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App (web)
WEBAPP_URL=http://localhost:5173
# Public base URL of the API / uploads. MUST be public HTTPS for real Telegram (shareToStory).
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Storage ----------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------- GRM (Gram jetton on TON) ----------
GRM_JETTON_MASTER=EQC47093oX5Xhb0xuk2lCr2RhS8rj-vul61u4W2UH5ORmG_O
GRM_DECIMALS=9
GRM_SYMBOL=GRAM

# ---------- Marathon Boost prices ----------
# !!! PLACEHOLDERS: the owner MUST set the real prices before launch !!!
# GRM amounts are human-readable (converted to smallest units with bigint math, never floats).
GRM_BOOST_24H_PRICE=50
GRM_BOOST_7D_PRICE=250
# Telegram Stars (integers). Defaults: 100 / 500.
STARS_BOOST_24H_PRICE=100
STARS_BOOST_7D_PRICE=500
# A boost can never extend further than this many days into the future (stacking guard)
BOOST_MAX_HORIZON_DAYS=30

# ---------- Anti-abuse rate limits (NOT business quotas; per authenticated user) ----------
# Exceeding them returns RATE_LIMITED (HTTP 429) with a friendly message, never a paywall.
RATE_LIMIT_GLOBAL_PER_MIN=240
RATE_LIMIT_POSTS_PER_MIN=20
RATE_LIMIT_CHAINS_PER_HOUR=10
RATE_LIMIT_REPORTS_PER_HOUR=10
RATE_LIMIT_PAYMENTS_PER_MIN=10

# ---------- TON ----------
# Required in production (empty ok in dev/mock)
TON_MERCHANT_ADDRESS=
# mainnet | testnet
TON_NETWORK=mainnet
TONAPI_KEY=
# Public URL of tonconnect-manifest.json (web)
TONCONNECT_MANIFEST_URL=http://localhost:5173/tonconnect-manifest.json
# true = offer GRM on iOS/Android too (verify Telegram policy first)
TON_PAYMENTS_ALL_PLATFORMS=false

# ---------- Web (Vite) ----------
VITE_DEV_MOCK=true
# Leave empty to use same-origin /api (Vite proxy in dev, Fastify single-origin in prod)
VITE_API_URL=
VITE_BOT_USERNAME=storychain_bot
# Optional Mini App short name (used for the TonConnect return URL)
VITE_APP_SHORT_NAME=
# Optional; default: <origin>/tonconnect-manifest.json (generated from WEBAPP_URL by `pnpm dev` / `pnpm build`)
VITE_TONCONNECT_MANIFEST_URL=
