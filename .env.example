# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
# Dev/mock mode: enables /api/dev/* endpoints. API REFUSES to start if true with NODE_ENV=production.
DEV_MODE=true
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
# SQLite in dev; for prod switch provider in prisma/schema.prisma to "postgresql" and use a postgres URL (see README)
DATABASE_URL=file:./dev.db

# ---------- Telegram ----------
# Token from @BotFather. In DEV_MODE a dummy token is fine (initData is signed with it locally).
BOT_TOKEN=000000:dev-token-change-me
BOT_USERNAME=storychain_bot
# Optional Mini App short name (https://t.me/<bot>/<short>?startapp=...)
APP_SHORT_NAME=
# polling (dev) | webhook (prod)
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=
# Public HTTPS URL of the Mini App (web)
WEBAPP_URL=http://localhost:5173
# Public base URL of the API / uploads. MUST be public HTTPS for real Telegram (shareToStory).
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Storage ----------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---------- TON / GRM (Gram jetton) ----------
GRM_JETTON_MASTER=EQC47093oX5Xhb0xuk2lCr2RhS8rj-vul61u4W2UH5ORmG_O
GRM_DECIMALS=9
GRM_SYMBOL=GRAM
# Human readable amount; PLACEHOLDER - owner must set the real price
GRM_PRO_30D_PRICE=100
# Required in production (empty ok in dev/mock)
TON_MERCHANT_ADDRESS=
# mainnet | testnet
TON_NETWORK=mainnet
TONAPI_KEY=
# Public URL of tonconnect-manifest.json (web)
TONCONNECT_MANIFEST_URL=http://localhost:5173/tonconnect-manifest.json
# true = offer GRM on iOS/Android too (verify Telegram policy first)
TON_PAYMENTS_ALL_PLATFORMS=false

# ---------- Web (Vite) ----------
VITE_DEV_MOCK=true
# Leave empty to use same-origin /api (Vite proxy in dev, Fastify single-origin in prod)
VITE_API_URL=
VITE_BOT_USERNAME=storychain_bot
