// SQLite in dev. For production PostgreSQL: change `provider` to "postgresql" (see README).
// No Prisma enums / provider-specific features: enum-like values are Strings validated by zod.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  telegramId    BigInt         @unique
  username      String?
  firstName     String
  languageCode  String?
  isTgPremium   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  chains        Chain[]
  posts         Post[]
  transactions  Transaction[]
}

model Chain {
  id          String   @id
  title       String
  description String?
  emoji       String?
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id])
  isFeatured  Boolean  @default(false)
  isHidden    Boolean  @default(false)
  postsCount  Int      @default(0)
  createdAt   DateTime @default(now())
  posts       Post[]

  /// normalized "https://t.me/<name>" or "https://t.me/+<invite>" only; public only while boosted
  channelUrl   String?
  /// denormalized CACHE of "boostedUntil > now". Never trust it alone.
  isBoosted    Boolean       @default(false)
  /// SOURCE OF TRUTH: the chain is boosted iff boostedUntil > now
  boostedUntil DateTime?
  boosts       ChainBoost[]
  transactions Transaction[]

  @@index([isFeatured, createdAt])
  @@index([isBoosted, boostedUntil])
}

model Post {
  id            String   @id @default(cuid())
  chainId       String
  userId        String
  position      Int
  imageUrl      String
  thumbUrl      String
  templateId    String
  caption       String?
  watermarked   Boolean
  sharedToStory Boolean  @default(false)
  isHidden      Boolean  @default(false)
  createdAt     DateTime @default(now())
  chain         Chain    @relation(fields: [chainId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([chainId, userId])
  @@index([chainId, position])
}

model Transaction {
  id         String    @id @default(cuid())
  userId     String
  provider   String
  planId     String
  status     String
  amount     String
  currency   String
  reference  String    @unique
  externalId String?   @unique
  rawJson    String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  expiresAt  DateTime
  /// required for boost purchases; nullable only for legacy rows
  chainId    String?
  chain      Chain?    @relation(fields: [chainId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@index([status, provider])
  @@index([chainId])
}

model ChainBoost {
  id        String   @id @default(cuid())
  chainId   String
  userId    String
  /// "boost_24h" | "boost_7d"
  planId    String
  startsAt  DateTime
  endsAt    DateTime
  /// one boost per paid transaction (idempotency)
  txId      String   @unique
  createdAt DateTime @default(now())
  chain     Chain    @relation(fields: [chainId], references: [id])

  @@index([chainId, endsAt])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  chainId    String?
  postId     String?
  reason     String
  createdAt  DateTime @default(now())
}
