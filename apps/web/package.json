{
  "name": "@storychain/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env VITE_DEV_MOCK=false tsc --noEmit && cross-env VITE_DEV_MOCK=false vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "predev": "node scripts/gen-manifest.mjs",
    "prebuild": "node scripts/gen-manifest.mjs",
    "analyze": "cross-env VITE_DEV_MOCK=false ANALYZE=1 vite build"
  },
  "dependencies": {
    "@storychain/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.1",
    "@ton/core": "^0.63.1",
    "@tonconnect/ui-react": "^3.0.2",
    "buffer": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
